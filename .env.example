# Environment configuration template.
#
# Copy this file to `.env` and fill in real values for your environment.
# Never commit `.env` — only `.env.example` is tracked in Git.
#
# This file currently documents the planned variable categories. Concrete
# variables are introduced as each part of the foundation is implemented
# (Django settings in S0-002, PostgreSQL in S0-004, GraphQL in S0-005,
# full environment strategy in S0-006).

# --- General ---
# ENVIRONMENT=local   # local | development | staging | production

# --- Django (added in S0-002 / S0-006) ---
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=
# DJANGO_ALLOWED_HOSTS=

# --- Database (added in S0-004) ---
# DATABASE_URL=

# --- Redis / Celery (placeholder, not yet used) ---
# REDIS_URL=

# --- GraphQL (added in S0-005) ---
# GRAPHQL_ENABLE_PLAYGROUND=

# --- CORS (added in S0-006 / S0-011) ---
# CORS_ALLOWED_ORIGINS=

# --- Frontend (added in S0-003) ---
# VITE_API_BASE_URL=
# VITE_GRAPHQL_URL=

# --- Storage (placeholder, not yet used) ---
# STORAGE_BACKEND=
# STORAGE_BUCKET_NAME=

# --- AI Gateway (placeholder, not yet used) ---
# AI_GATEWAY_BASE_URL=

# --- Email (placeholder, not yet used) ---
# EMAIL_BACKEND=
