{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/consistent-type-imports": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],

    // Automatic JSX runtime (tsconfig "jsx": "react-jsx"): React need not be in scope.
    "react/react-in-jsx-scope": "off",
    // Side-effect imports are intentional (CSS, test setup).
    "import/no-unassigned-import": "off",
    // Stylistic; would force edits to existing tests.
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": ["dist", "coverage"]
}
